{
  "name": "justcilledai",
  "version": "1.0.0",
  "description": "JustCilledAI - Real-time Desktop AI Assistant with live audio transcription, screen understanding, and floating HUD",
  "main": "dist/app/electron/main/index.js",
  "type": "module",
  "scripts": {
    "start": "npm run build && ELECTRON_RUN_AS_NODE=\"\" electron .",
    "dev": "concurrently -k \"vite\" \"npm run dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && ELECTRON_RUN_AS_NODE=\"\" VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "package:mac": "npm run build && electron-builder --mac --arm64",
    "package:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.21.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
