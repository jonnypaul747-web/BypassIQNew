# Database URL (Render PostgreSQL will provide this)
DATABASE_URL=postgresql://localhost:5432/justcilledai

# Server port (Render will set this automatically)
PORT=3000

# OpenAI API Key for document Q&A generation
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Shared secret for server-to-server calls
API_KEY=

# OCR Settings
OCR_ENABLED=1
OCR_MAX_PAGES=3
OCR_SCALE=2
OCR_MIN_TEXT_CHARS=80

# AI Settings
AI_MODEL=gpt-4o-mini
AI_MAX_DOCUMENT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=1400
AI_MAX_QUESTIONS=15
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MINUTES=60

# Environment
NODE_ENV=production
